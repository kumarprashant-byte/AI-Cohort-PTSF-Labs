{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install*)",
      "Bash(npx skills*)",
      "Bash(npx -y skills*)",
      "Bash(sf *)",
      "Bash(pi *)",
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-plugin-installed.mjs\""
          }
        ]
      }
    ]
  }
}
