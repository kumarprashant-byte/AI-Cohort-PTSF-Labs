<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Share_EMEA_Applications</fullName>
        <accessLevel>Edit</accessLevel>
        <description>INT-020 — share EMEA Subsidy Applications with the EMEA Regional Ops Manager role and its subordinates (Team Manager, Assessor).</description>
        <label>Share EMEA Applications</label>
        <sharedTo>
            <roleAndSubordinates>EMEA_Regional_Ops_Manager</roleAndSubordinates>
        </sharedTo>
        <booleanFilter></booleanFilter>
        <criteriaItems>
            <field>Region__c</field>
            <operation>equals</operation>
            <value>EMEA</value>
        </criteriaItems>
    </sharingCriteriaRules>
