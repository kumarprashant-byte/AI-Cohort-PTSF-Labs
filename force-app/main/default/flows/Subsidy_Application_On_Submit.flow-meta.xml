<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>INT-008 — On Status change to Submitted: snapshot the patient's Medical History, publish HIC_Entitlement_Requested__e, and advance Status to Awaiting_Insurance_Check.</description>
    <environments>Default</environments>
    <interviewLabel>Subsidy Application On Submit {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Subsidy Application On Submit</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Medical_History</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <object>Subsidy_Application__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value><stringValue>Submitted</stringValue></value>
        </filters>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
    </start>
    <recordLookups>
        <name>Get_Medical_History</name>
        <label>Get Medical History rows</label>
        <locationX>50</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Build_Snapshot</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Patient__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Patient__c</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Medical_History__c</object>
        <outputReference>MedicalHistoryRows</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Notes__c</queriedFields>
        <queriedFields>CreatedDate</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>
    <loops>
        <name>Build_Snapshot</name>
        <label>Build snapshot loop</label>
        <locationX>50</locationX>
        <locationY>240</locationY>
        <collectionReference>MedicalHistoryRows</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Append_Row</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Publish_HIC_Request</targetReference>
        </noMoreValuesConnector>
    </loops>
    <assignments>
        <name>Append_Row</name>
        <label>Append row to snapshot</label>
        <locationX>200</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>SnapshotText</assignToReference>
            <operator>Add</operator>
            <value><elementReference>Build_Snapshot.Name</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SnapshotText</assignToReference>
            <operator>Add</operator>
            <value><stringValue> | </stringValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SnapshotText</assignToReference>
            <operator>Add</operator>
            <value><elementReference>Build_Snapshot.Notes__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SnapshotText</assignToReference>
            <operator>Add</operator>
            <value><stringValue>
</stringValue></value>
        </assignmentItems>
        <connector>
            <targetReference>Build_Snapshot</targetReference>
        </connector>
    </assignments>
    <recordCreates>
        <name>Publish_HIC_Request</name>
        <label>Publish HIC_Entitlement_Requested__e</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <connector>
            <targetReference>Update_Application</targetReference>
        </connector>
        <inputAssignments>
            <field>Source_Record_Id__c</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Submitted_At__c</field>
            <value><elementReference>$Flow.CurrentDateTime</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Request_JSON__c</field>
            <value><elementReference>IdempotencyKey</elementReference></value>
        </inputAssignments>
        <object>HIC_Entitlement_Requested__e</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Update_Application</name>
        <label>Advance Status + stamp Submitted_At + snapshot</label>
        <locationX>50</locationX>
        <locationY>480</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value><stringValue>Awaiting_Insurance_Check</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Submitted_At__c</field>
            <value><elementReference>$Flow.CurrentDateTime</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Medical_History_Snapshot__c</field>
            <value><elementReference>SnapshotText</elementReference></value>
        </inputAssignments>
        <object>Subsidy_Application__c</object>
    </recordUpdates>
    <variables>
        <name>MedicalHistoryRows</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Medical_History__c</objectType>
    </variables>
    <variables>
        <name>SnapshotText</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value><stringValue>Medical History Snapshot at submission:
</stringValue></value>
    </variables>
    <formulas>
        <name>IdempotencyKey</name>
        <dataType>String</dataType>
        <expression>{!$Record.Id} &amp; &quot;-&quot; &amp; TEXT({!$Flow.CurrentDateTime})</expression>
    </formulas>
    <status>Active</status>
</Flow>
