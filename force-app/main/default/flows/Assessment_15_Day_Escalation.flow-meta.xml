<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <assignments>
        <name>Collect_Task</name>
        <label>Collect Task for insert</label>
        <locationX>200</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>NewTask.Subject</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Escalation — Assessment pending &gt; 15 days</stringValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewTask.WhatId</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Assessments.Id</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewTask.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Assessments.OwnerId</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewTask.Priority</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>High</stringValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TasksToInsert</assignToReference>
            <operator>Add</operator>
            <value><elementReference>NewTask</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>UpdatedAssessment.Id</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Assessments.Id</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>UpdatedAssessment.Escalated__c</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>true</booleanValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>UpdatedAssessment.Escalated_Date__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Flow.CurrentDate</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AssessmentsToUpdate</assignToReference>
            <operator>Add</operator>
            <value><elementReference>UpdatedAssessment</elementReference></value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Assessments</targetReference>
        </connector>
    </assignments>
    <description>INT-012 — Daily scan for Pending Assessment__c older than 15 days; create escalation Task and stamp Escalated__c + Escalated_Date__c. Task owner = Assessment.OwnerId as a pragmatic default; real Team-Manager routing 📋 to INT-005+INT-020 follow-on.</description>
    <environments>Default</environments>
    <interviewLabel>Assessment 15-Day Escalation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Assessment 15-Day Escalation</label>
    <loops>
        <name>Loop_Assessments</name>
        <label>Loop matching assessments</label>
        <locationX>50</locationX>
        <locationY>240</locationY>
        <collectionReference>PendingAssessments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Collect_Task</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Insert_Tasks</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Insert_Tasks</name>
        <label>Insert escalation Tasks</label>
        <locationX>50</locationX>
        <locationY>480</locationY>
        <connector>
            <targetReference>Update_Assessments</targetReference>
        </connector>
        <inputReference>TasksToInsert</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Pending_Assessments</name>
        <label>Get Pending Assessments &gt; 15 days</label>
        <locationX>50</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Assessments</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value><stringValue>Pending Review</stringValue></value>
        </filters>
        <filters>
            <field>Escalated__c</field>
            <operator>EqualTo</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <filters>
            <field>Assigned_Date__c</field>
            <operator>LessThan</operator>
            <value><elementReference>FifteenDaysAgo</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Assessment__c</object>
        <outputReference>PendingAssessments</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Assessments</name>
        <label>Stamp Escalated fields</label>
        <locationX>50</locationX>
        <locationY>600</locationY>
        <inputReference>AssessmentsToUpdate</inputReference>
    </recordUpdates>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Pending_Assessments</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-10-01</startDate>
            <startTime>02:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>PendingAssessments</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Assessment__c</objectType>
    </variables>
    <variables>
        <name>TasksToInsert</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
    <variables>
        <name>AssessmentsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Assessment__c</objectType>
    </variables>
    <variables>
        <name>NewTask</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
    <variables>
        <name>UpdatedAssessment</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Assessment__c</objectType>
    </variables>
    <formulas>
        <name>FifteenDaysAgo</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - 15</expression>
    </formulas>
</Flow>
