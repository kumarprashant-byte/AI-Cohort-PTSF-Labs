<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <decisions>
        <name>Rule_Found</name>
        <label>Rule Found?</label>
        <locationX>350</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Screen_No_Rule</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No rule</defaultConnectorLabel>
        <rules>
            <name>Has_Rule</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Rule.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Review</targetReference>
            </connector>
            <label>Rule exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Under_Threshold</name>
        <label>Under Threshold?</label>
        <locationX>350</locationX>
        <locationY>600</locationY>
        <defaultConnector>
            <targetReference>Update_App_Over</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Over</defaultConnectorLabel>
        <rules>
            <name>Under</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Adjusted_Amount</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue><elementReference>Rule.Threshold__c</elementReference></rightValue>
            </conditions>
            <connector>
                <targetReference>Update_App_Under</targetReference>
            </connector>
            <label>Under or equal</label>
        </rules>
    </decisions>
    <description>INT-014 — Screen Flow that computes a proposed subsidy amount from region-specific transport multipliers and stamps Approved_Amount__c only when Proposed &lt;= Rule.Threshold. Over-threshold applications leave Approved_Amount__c null so the (deferred) Approval Process must run. Launched from the Application_Review console utility bar.</description>
    <environments>Default</environments>
    <formulas>
        <name>Proposed_Amount</name>
        <dataType>Number</dataType>
        <expression>{!Distance_Km} * {!Rule.Multiplier__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Determine Subsidy {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Determine Subsidy</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Application</name>
        <label>Get Application</label>
        <locationX>350</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_Inputs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Subsidy_Application__c</object>
        <outputReference>App</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Region__c</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Rule</name>
        <label>Get Rule</label>
        <locationX>350</locationX>
        <locationY>240</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Rule_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Region__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>App.Region__c</elementReference></value>
        </filters>
        <filters>
            <field>Transport_Type__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>Transport_Type</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Subsidy_Determination_Rule__c</object>
        <outputReference>Rule</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Multiplier__c</queriedFields>
        <queriedFields>Threshold__c</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_App_Under</name>
        <label>Stamp Proposed + Approved (under threshold)</label>
        <locationX>200</locationX>
        <locationY>720</locationY>
        <connector>
            <targetReference>Screen_Done_Under</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Proposed_Amount__c</field>
            <value><elementReference>Adjusted_Amount</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Approved_Amount__c</field>
            <value><elementReference>Adjusted_Amount</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Transport_Type__c</field>
            <value><elementReference>Transport_Type</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Distance_Km__c</field>
            <value><elementReference>Distance_Km</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Adjustment_Reason__c</field>
            <value><elementReference>Adjustment_Reason</elementReference></value>
        </inputAssignments>
        <object>Subsidy_Application__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_App_Over</name>
        <label>Stamp Proposed only (over threshold)</label>
        <locationX>500</locationX>
        <locationY>720</locationY>
        <connector>
            <targetReference>Screen_Done_Over</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Proposed_Amount__c</field>
            <value><elementReference>Adjusted_Amount</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Transport_Type__c</field>
            <value><elementReference>Transport_Type</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Distance_Km__c</field>
            <value><elementReference>Distance_Km</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Adjustment_Reason__c</field>
            <value><elementReference>Adjustment_Reason</elementReference></value>
        </inputAssignments>
        <object>Subsidy_Application__c</object>
    </recordUpdates>
    <runInMode>DefaultMode</runInMode>
    <screens>
        <name>Screen_Inputs</name>
        <label>Transport and distance</label>
        <locationX>350</locationX>
        <locationY>120</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Get_Rule</targetReference>
        </connector>
        <fields>
            <name>Transport_Type</name>
            <choiceReferences>Choice_Air</choiceReferences>
            <choiceReferences>Choice_Rail</choiceReferences>
            <choiceReferences>Choice_Road</choiceReferences>
            <choiceReferences>Choice_Sea</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Transport type</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Distance_Km</name>
            <dataType>Number</dataType>
            <fieldText>Distance (km)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>2</scale>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Review</name>
        <label>Review proposed amount</label>
        <locationX>350</locationX>
        <locationY>480</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Under_Threshold</targetReference>
        </connector>
        <fields>
            <name>Proposed_Display</name>
            <fieldText>&lt;p&gt;Proposed amount: &lt;b&gt;{!Proposed_Amount}&lt;/b&gt; (Distance {!Distance_Km} km × multiplier {!Rule.Multiplier__c}). Regional threshold: {!Rule.Threshold__c}.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Adjusted_Amount</name>
            <dataType>Number</dataType>
            <defaultValue><elementReference>Proposed_Amount</elementReference></defaultValue>
            <fieldText>Adjusted amount</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>2</scale>
        </fields>
        <fields>
            <name>Adjustment_Reason</name>
            <dataType>String</dataType>
            <fieldText>Adjustment reason (required if you changed the amount)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_No_Rule</name>
        <label>No rule</label>
        <locationX>50</locationX>
        <locationY>480</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>No_Rule_Text</name>
            <fieldText>&lt;p&gt;No Subsidy Determination Rule exists for Region {!App.Region__c} and Transport Type {!Transport_Type}. Ask an admin to create one, then re-run.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Done_Under</name>
        <label>Approved within limits</label>
        <locationX>200</locationX>
        <locationY>840</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Done_Under_Text</name>
            <fieldText>&lt;p&gt;Approved. Proposed_Amount and Approved_Amount both stamped as &lt;b&gt;{!Adjusted_Amount}&lt;/b&gt;.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Done_Over</name>
        <label>Over threshold — submit for approval</label>
        <locationX>500</locationX>
        <locationY>840</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Done_Over_Text</name>
            <fieldText>&lt;p&gt;Over threshold — submit for approval. Proposed_Amount stamped as &lt;b&gt;{!Adjusted_Amount}&lt;/b&gt;; Approved_Amount left blank until a Team Manager approves.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>200</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Application</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>App</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Subsidy_Application__c</objectType>
    </variables>
    <variables>
        <name>Rule</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Subsidy_Determination_Rule__c</objectType>
    </variables>
    <choices>
        <name>Choice_Air</name>
        <choiceText>Air</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Air</stringValue></value>
    </choices>
    <choices>
        <name>Choice_Rail</name>
        <choiceText>Rail</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Rail</stringValue></value>
    </choices>
    <choices>
        <name>Choice_Road</name>
        <choiceText>Road</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Road</stringValue></value>
    </choices>
    <choices>
        <name>Choice_Sea</name>
        <choiceText>Sea</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Sea</stringValue></value>
    </choices>
</Flow>
